# Copy this file to .env.local for a local preview.
# These values are for a developer's own SQLite database only.
APP_PROFILE=local
DATABASE_BACKEND=sqlite
DATABASE_URL=
FASTAPI_INTERNAL_URL=http://127.0.0.1:8000
ALLOW_PUBLIC_REGISTRATION=false
AUTH_COOKIE_SECURE=false

# Local preview account. This example password is intentionally public and must
# never be reused in a deployed environment.
LOCAL_TEST_EMAIL=localtest@example.com
LOCAL_TEST_PASSWORD=robo-local-2026
LOCAL_TEST_DISPLAY_NAME=Local Test User

# Optional local administrator. Leave the password empty to skip its creation.
LOCAL_ADMIN_EMAIL=localadmin@example.com
LOCAL_ADMIN_PASSWORD=
LOCAL_ADMIN_DISPLAY_NAME=Local Admin
