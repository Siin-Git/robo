# Copy to .env (never commit .env). All values read via src/db/config.py.
DATABASE_BACKEND=sqlite
# PostgreSQL (psycopg). Example — fill in real credentials locally only.
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/robo_advisor
DATABASE_URL=
# Integration tests against a real PostgreSQL (skipped when empty).
TEST_DATABASE_URL=

# Phase 3B API
APP_PROFILE=demo
CORS_ALLOWED_ORIGINS=http://localhost:3000
API_HOST=0.0.0.0
API_PORT=8000

# Phase 3C auth (default: closed registration; demo may set true)
ALLOW_PUBLIC_REGISTRATION=false
# Local HTTP dev over live profile (never in production):
# AUTH_COOKIE_SECURE=0
